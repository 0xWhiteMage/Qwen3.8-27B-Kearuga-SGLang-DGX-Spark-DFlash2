# Qwen3.8-27B on one DGX Spark (GB10), via SGLang.
# Copy this file to .env, then start one serving profile:
#
# DFlash 2:
#   bash patch/build-dflash2-image.sh
#   ./start-dflash2.sh
#
# EAGLE:
#   ./start-eagle.sh
#
# DFlash defaults = four admitted requests with a 1,048,576-token pool.
# Each request retains the native 262,144-token context, so all four requests
# can simultaneously reach the full context limit.
#
# Thinking stays on in the server. Agents should send
#   chat_template_kwargs={"enable_thinking": false}
#   temperature=0

CONTEXT_LENGTH=262144
MAX_CONCURRENT_REQUESTS=4
MAX_TOTAL_TOKENS=1048576
DFLASH_DRAFT_WINDOW_SIZE=2048
DFLASH_DRAFT_TOKENS=8
CHUNKED_PREFILL=8192

# SGLang request priorities: interactive clients send priority=100; batch
# clients use priority=0. A gap >=10 allows decode preemption when all seats
# are occupied. An active long prefill is not preemptible.
PRIORITY_SCHEDULING=1
DEFAULT_PRIORITY_VALUE=0
PRIORITY_PREEMPTION_THRESHOLD=10
CPUSET=5-9,15-19
MEM_FRACTION=0.90
DFLASH_IMAGE=lmsysorg/sglang:qwen38-27b-dflash2
TARGET_MODEL=RadixArk/Qwen3.8-27B-NVFP4
TARGET_REV=554ebba9b5f1b79dc11246341960360e6ef05ef4
DFLASH_MODEL=z-lab/Qwen3.8-27B-DFlash2
DFLASH_REV=50307d4c4cde6860d4eee73e2547cd786fe8e8a4

# EAGLE high-concurrency profile. These are intentionally separate from the
# DFlash values above so both launchers can share one .env.
EAGLE_CONTEXT_LENGTH=262144
EAGLE_MAX_CONCURRENT_REQUESTS=32
EAGLE_MAX_TOTAL_TOKENS=1048576
EAGLE_SPEC_STEPS=3
EAGLE_SPEC_TOPK=1
EAGLE_SPEC_DRAFT=4
EAGLE_CONTINUOUS_DECODE_STEPS=1
EAGLE_TORCH_COMPILE_MAX_BS=4
EAGLE_CUDA_GRAPH_MAX_BS=32
EAGLE_SPEC_ATTENTION_MODE=decode
EAGLE_CHUNKED_PREFILL=8192
EAGLE_CPUSET=5-9,15-19
EAGLE_MEM_FRACTION=0.90
EAGLE_IMAGE=lmsysorg/sglang@sha256:3c0abdf41ef22de9d7a859dc16ed71eae69452e36c91f071a25e60c85a6d1fc6
